# Supabase project settings. Keep the service role key server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=expense-proofs

# Required in production. Use a long, unique password.
SITE_PASSWORD=replace-with-a-strong-password

# Optional display identity for password-protected Vercel deployments.
# Keep the default email after the first team has been created unless you also
# add the new email as an admin member.
TEAMSPEND_ADMIN_EMAIL=owner@local.demo
TEAMSPEND_ADMIN_NAME=Rog
